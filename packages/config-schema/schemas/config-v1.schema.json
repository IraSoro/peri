{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/config-v1",
  "title": "Config V1",
  "description": "Peri config used in the app before the V2 format",
  "type": "object",
  "$defs": {
    "Cycle": {
      "type": "object",
      "properties": {
        "cycleLength": {
          "description": "Cycle length in days. 0 for the current (unfinished) cycle",
          "type": "integer",
          "minimum": 0
        },
        "periodLength": {
          "description": "Period length in days",
          "type": "integer",
          "minimum": 1
        },
        "startDate": {
          "description": "Date.prototype.toString() output",
          "type": "string",
          "pattern": "^[A-Z][a-z]{2} [A-Z][a-z]{2} \\d{2} \\d{4} \\d{2}:\\d{2}:\\d{2} GMT[+-]\\d{4} \\(.+\\)$"
        }
      },
      "required": ["cycleLength", "periodLength", "startDate"]
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "cycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Cycle"
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "theme": {
      "type": "string",
      "enum": ["basic", "dark"]
    },
    "isNotificationEnabled": {
      "type": "boolean"
    },
    "lastNotificationId": {
      "type": "integer",
      "minimum": 0
    },
    "maxNumberOfDisplayedCycles": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "version",
    "cycles",
    "language",
    "theme",
    "isNotificationEnabled",
    "lastNotificationId",
    "maxNumberOfDisplayedCycles"
  ]
}
