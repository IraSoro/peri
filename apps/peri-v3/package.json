    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "es-toolkit": "^1.44.0",
    "lucide-react": "^1.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
